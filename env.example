# 只列出键名。值由部署机从现网拷贝，不要把已填写的密钥提交进仓库。
# 进程启动时读取 NYH_LINE_ENV_FILE 指向的文件，未设时读仓库根的 .env。
# 进程环境里的同名键优先于文件。文件只在启动时读一次，改完要重启对应程序。
# 旧的无前缀设备键（CENTER_DEVICE_ID 等）和 VTSI_ACCOUNT 已删除，留着会导致启动失败。

# Center 地址（六条线路共用）
CENTER_PROTOCOL=
CENTER_HOST=
CENTER_VERSION=

# 菲岛 Globe（Interface 类型 2）
FD_GLOBE_CENTER_DEVICE_ID=
FD_GLOBE_CENTER_DEVICE_KEY=
FD_GLOBE_CENTER_SIM_ID=
FD_GLOBE_UID=
FD_GLOBE_KEY=
FD_GLOBE_URL=
FD_GLOBE_ALERT_USER_IDS=

# 菲岛 Smart（Interface 类型 4）
FD_SMART_CENTER_DEVICE_ID=
FD_SMART_CENTER_DEVICE_KEY=
FD_SMART_CENTER_SIM_ID=
FD_SMART_UID=
FD_SMART_KEY=
FD_SMART_URL=
FD_SMART_ALERT_USER_IDS=

# VTSI 三条共用的用户名、密码和 WSDL
VTSI_USERNAME=
VTSI_PASSWORD=
VTSI_WSDL=

# VTSI Dito
VTSI_DITO_CENTER_DEVICE_ID=
VTSI_DITO_CENTER_DEVICE_KEY=
VTSI_DITO_CENTER_SIM_ID=
VTSI_DITO_ACCOUNT=
VTSI_DITO_ALERT_USER_IDS=

# VTSI Globe
VTSI_GLOBE_CENTER_DEVICE_ID=
VTSI_GLOBE_CENTER_DEVICE_KEY=
VTSI_GLOBE_CENTER_SIM_ID=
VTSI_GLOBE_ACCOUNT=
VTSI_GLOBE_ALERT_USER_IDS=

# VTSI Smart
VTSI_SMART_CENTER_DEVICE_ID=
VTSI_SMART_CENTER_DEVICE_KEY=
VTSI_SMART_CENTER_SIM_ID=
VTSI_SMART_ACCOUNT=
VTSI_SMART_ALERT_USER_IDS=

# 赢啦
XIAOLA_CENTER_DEVICE_ID=
XIAOLA_CENTER_DEVICE_KEY=
XIAOLA_CENTER_SIM_ID=
XIAOLA_API_BASE_URL=
XIAOLA_API_USERNAME=
XIAOLA_API_SECRET_KEY=
DEVICE_TYPE_XIAOLA=
BLOCKLIST_FILE_PATH=
XIAOLA_ALERT_USER_IDS=
# 以下数值留空取默认值（1、3、10、15），填写时必须是有限的正数
MAX_THREADS=
RECHARGE_INTERVAL_TIME=
RECHARGE_MAX_TASKS_PER_BATCH=
RECHARGE_BATCH_INTERVAL=
THREAD1_COUNTRY_CODE=
THREAD2_COUNTRY_CODE=
THREAD3_COUNTRY_CODE=
THREAD4_COUNTRY_CODE=
THREAD5_COUNTRY_CODE=
THREAD6_COUNTRY_CODE=
THREAD7_COUNTRY_CODE=
THREAD8_COUNTRY_CODE=
THREAD9_COUNTRY_CODE=
THREAD10_COUNTRY_CODE=
